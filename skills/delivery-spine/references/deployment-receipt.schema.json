{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.invalid/schemas/deployment-receipt.v1.json",
  "title": "Environment-qualified deployment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "deployable_unit",
    "endpoint",
    "artifact_identity",
    "public_configuration_identity",
    "source_identity",
    "deployment",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "deployable_unit": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "endpoint": {
      "type": "string",
      "pattern": "^https://[^?#\\s]+$",
      "maxLength": 2048
    },
    "artifact_identity": { "$ref": "#/$defs/sha256" },
    "public_configuration_identity": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "source_identity": { "$ref": "#/$defs/sha256" },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "receipt"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "receipt": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
