{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.local/schemas/delivery-spine.schema.json",
  "title": "Workspace delivery spine",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "active_staging_slice", "journeys"],
  "properties": {
    "schema_version": { "const": 1 },
    "active_staging_slice": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "journeys": {
      "type": "array",
      "items": { "$ref": "#/$defs/journey" }
    }
  },
  "$defs": {
    "level": { "enum": ["source_complete", "integrated", "staging_verified"] },
    "evidenceClass": { "enum": ["component", "contract", "integrated_local", "staging_e2e"] },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_id", "outcome", "work_item_id", "target_level", "current_level", "boundaries", "evidence", "blockers", "affected_paths"],
      "properties": {
        "journey_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "outcome": { "type": "string", "minLength": 1 },
        "work_item_id": { "type": "string", "minLength": 1 },
        "target_level": { "$ref": "#/$defs/level" },
        "current_level": { "$ref": "#/$defs/level" },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "owner", "target", "state"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "state": { "enum": ["missing", "source_only", "configured", "deployed", "verified"] }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "reference", "observed_at"],
            "properties": {
              "class": { "$ref": "#/$defs/evidenceClass" },
              "reference": { "type": "string", "minLength": 1 },
              "observed_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "affected_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
