{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.local/schemas/delivery-spine-claim.schema.json",
  "title": "Delivery Spine claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "journey_id", "work_item_id", "target_level", "current_level", "boundaries", "evidence", "blockers"],
  "properties": {
    "schema_version": { "const": 2 },
    "claim_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "journey_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "work_item_id": { "type": "string", "minLength": 1 },
    "target_level": { "$ref": "#/$defs/level" },
    "current_level": { "$ref": "#/$defs/level" },
    "boundaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/boundary" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "level": { "enum": ["source_complete", "integrated", "staging_verified"] },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "target", "state"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "state": { "enum": ["missing", "source_only", "configured", "deployed", "verified"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "reference", "observed_at"],
      "properties": {
        "class": { "enum": ["component", "contract", "integrated_local", "staging_e2e"] },
        "reference": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
