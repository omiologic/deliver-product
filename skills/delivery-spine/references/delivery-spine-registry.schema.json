{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.local/schemas/delivery-spine-registry.schema.json",
  "title": "Delivery Spine journey registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journeys"],
  "properties": {
    "schema_version": { "const": 2 },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["journey_id", "outcome", "affected_paths", "suites"],
        "properties": {
          "journey_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "outcome": { "type": "string", "minLength": 1 },
          "affected_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "suites": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
