{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.local/schemas/delivery-spine-baseline.schema.json",
  "title": "Delivery Spine compact baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journey_id", "claim_id", "current_level", "boundaries", "evidence"],
  "properties": {
    "schema_version": { "const": 2 },
    "journey_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "claim_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "current_level": { "enum": ["source_complete", "integrated", "staging_verified"] },
    "boundaries": { "type": "array", "minItems": 1, "items": { "$ref": "delivery-spine-claim.schema.json#/$defs/boundary" } },
    "evidence": { "type": "array", "items": { "$ref": "delivery-spine-claim.schema.json#/$defs/evidence" } }
  }
}
